# Copy to .env on the NAS. Never commit .env or send these values in chat.
# This release tag has passed both platform smoke checks and publication; a digest
# such as brisebois/sentrame@sha256:... makes the selected artifact immutable.
# Historical baseline; does not include structural-v2 trace exploration.
# Multi-app source requires a reviewed supporting image and a fresh private data directory.
SENTRAME_IMAGE=brisebois/sentrame:v0.1.0-rc.1
# Exact browser origin; no trailing slash. Standard local example:
SENTRAME_ORIGIN=http://127.0.0.1:8096
SENTRAME_PORT=8096
# For compose.cloudflare.yaml, use your public HTTPS origin instead, for example:
# SENTRAME_ORIGIN=https://sentrame.example.com
# Existing local folder, writable by UID/GID 10001. An absolute path is preferred.
SENTRAME_DATA_DIR=./data
SENTRAME_PASSPHRASE=

# Producer base URL depends on sender location; another container uses its reachable
# service address (e.g. http://sentrame:8096), never its own loopback.
# OTLP uses HTTP Protobuf with /v1/logs or /v1/traces signal paths.
# Register apps in the owner UI. Generated browser/server credentials live in private /data/apps.json.
# No producer environment tokens or legacy import. Keep server credentials server-only.
# Browser exporters use a reviewed app-origin forwarder.
