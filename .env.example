# Copy to .env on the NAS. Never commit .env or send these values in chat.
# This release tag has passed both platform smoke checks and publication; a digest
# such as brisebois/sentrame@sha256:... makes the selected artifact immutable.
SENTRAME_IMAGE=brisebois/sentrame:v0.1.0-rc.1
# Exact browser origin; no trailing slash. Standard local example:
SENTRAME_ORIGIN=http://127.0.0.1:8096
SENTRAME_PORT=8096
# For compose.cloudflare.yaml, use your public HTTPS origin instead, for example:
# SENTRAME_ORIGIN=https://sentrame.example.com
# Existing local folder, writable by UID/GID 10001. An absolute path is preferred.
SENTRAME_DATA_DIR=./data
SENTRAME_PASSPHRASE=
SENTRAME_BROWSER_TOKEN=
SENTRAME_SERVER_TOKEN=
